<?xml version="1.0" encoding="utf-8"?>
<!-- Padding is the Android TV safe area: the target TV crops roughly the bottom 11dp,
     and the game's footer carries the room code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stage"
    android:paddingLeft="48dp"
    android:paddingTop="27dp"
    android:paddingRight="48dp"
    android:paddingBottom="27dp">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="monospace"
        android:text="@string/status_opening"
        android:textColor="@color/paper_light"
        android:textSize="22sp"
        android:visibility="gone" />
</FrameLayout>
